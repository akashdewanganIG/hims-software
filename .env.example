# Copy to .env and adjust. Sections mirror what reads each key.
#
# Without DATABASE_URL the app runs in browser mode: every browser keeps its
# own sandbox hospital in IndexedDB. With it, PostgreSQL is the system of
# record — every signed-in browser works on the same hospital, and every
# change is validated and committed on the server.

# ============================================================
# DATABASE — PostgreSQL 15+ through Drizzle ORM: Neon when hosted, or a
# local PostgreSQL for development.
#
# Neon (https://neon.tech): create a project, then copy two connection
# strings from its dashboard ("Connect"):
#   DATABASE_URL — the pooled one (the host contains "-pooler"); the app
#                  reaches Neon hosts with Neon's serverless driver
#   DIRECT_URL   — the direct one (no "-pooler"); used by migrations and
#                  Drizzle Studio.
# e.g.
#   DATABASE_URL="postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
#   DIRECT_URL="postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require"
# then: npm run db:migrate && npm run db:seed
#
# Local: `npm run db:up` starts PostgreSQL on localhost:5433 (Docker, or
# your installed PostgreSQL binaries when Docker is not running).
# ============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5433/hims_simulation"
DIRECT_URL="postgresql://postgres:password@localhost:5433/hims_simulation"

# Signs the session cookie in server mode. 32+ random bytes; required when
# NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""