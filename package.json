{
  "name": "hims-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,md}\"",
    "test": "tsx --test \"tests/*.test.ts\"",
    "test:db": "tsx --test \"tests/db/*.test.ts\"",
    "test:db:neon": "node scripts/db/test-neon-driver.mjs",
    "verify:sim": "tsx scripts/verify-simulation.ts",
    "check": "npm run check-types && npm run lint && npm run format:check && npm test && npm run verify:sim",
    "doctor": "node scripts/doctor.mjs",
    "db:up": "node scripts/db/local-postgres.mjs up",
    "db:down": "node scripts/db/local-postgres.mjs down",
    "db:status": "node scripts/db/local-postgres.mjs status",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:generate": "node scripts/db/generate.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:verify": "tsx scripts/db/verify.ts",
    "db:proxy": "node scripts/db/ws-proxy.mjs",
    "e2e:opd": "node scripts/e2e/opd-journey.mjs",
    "e2e:ipd": "node scripts/e2e/ipd-journey.mjs",
    "e2e:roles": "tsx scripts/e2e/role-tour.ts",
    "e2e:access": "node scripts/e2e/access-journey.mjs",
    "e2e:records": "node scripts/e2e/records-journey.mjs",
    "e2e": "npm run e2e:roles && npm run e2e:opd && npm run e2e:ipd && npm run e2e:access && npm run e2e:records"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "elkjs": "^0.12.0",
    "next": "^16.3.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "19.1.1",
    "recharts": "3.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.7",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "playwright-core": "^1.55.0",
    "postcss": "8.5.26",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
